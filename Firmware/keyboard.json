{
    "manufacturer": "Gustavs",
    "keyboard_name": "vl_macropad",
    "maintainer": "gustav-kiu",
    "bootloader": "rp2040",
    "diode_direction": "ROW2COL",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP3", "pin_b": "GP2"}
        ]
    },
    "config": {
        "features": {
            "encoder_map": true
        }
    },
    "matrix_pins": {
        "cols": ["GP29", "GP6", "GP7", "GP0"],
        "rows": ["GP26", "GP27", "GP1"] 
    }, 
    "processor": "RP2040",
    "url": "https://github.com/gustav-kiu/vl_macropad",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT_ortho_2x4": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [1, 3], "x": 3, "y": 1},

                {"matrix": [2, 0], "x": 4, "y": 1}
            ]
        }
    }
}
